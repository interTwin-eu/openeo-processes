{
  "id": "raster2stac",
  "summary": "Generates STAC metadata from a RasterCube and optionally registers it to a remote STAC API.",
  "description": "Uses Raster2STAC to generate STAC Collection and Item metadata for a data cube. Uses 'item_id' as output folder and collection ID. Optionally posts to the collection_url endpoint.",
  "parameters": [
    {
      "name": "data",
      "description": "The input data cube",
      "schema": { "type": "object", "subtype": "raster-cube" }
    },
    {
      "name": "item_id",
      "description": "STAC item ID, collection ID, and output folder (used as the same)",
      "schema": { "type": "string" }
    },
    {
      "name": "collection_url",
      "description": "STAC API collections endpoint to be referenced in the metadata and optionally used for POST",
      "schema": { "type": "string" }
    },
    {
      "name": "description",
      "description": "STAC description",
      "schema": { "type": "string" }
    },
    {
      "name": "write_collection_assets",
      "schema": { "type": "boolean" },
      "optional": true
    },
    {
      "name": "license",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "keywords",
      "schema": {
        "type": "array",
        "items": { "type": "string" }
      },
      "optional": true
    },
    {
      "name": "providers",
      "schema": {
        "type": "array",
        "items": { "type": "object" }
      },
      "optional": true
    },
    {
      "name": "sci_citation",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "sci_doi",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "links",
      "schema": {
        "type": "array",
        "items": { "type": "object" }
      },
      "optional": true
    },
    {
      "name": "s3_upload",
      "schema": { "type": "boolean" },
      "optional": true
    },
    {
      "name": "s3_endpoint_url",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "bucket_name",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "bucket_file_prefix",
      "schema": { "type": "string" },
      "optional": true
    },
    {
      "name": "post_to_stac",
      "description": "Whether to POST the generated STAC metadata to a remote STAC API at collection_url.",
      "schema": { "type": "boolean" },
      "optional": true
    }
  ],
  "returns": {
    "description": "The unchanged input RasterCube.",
    "schema": {
      "type": "object",
      "subtype": "raster-cube"
    }
  },
  "categories": ["metadata", "stac", "upload"]
}
